{
  "name": "ai-english-pet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @pet/shared build && pnpm --parallel --filter @pet/shared --filter \"./apps/*\" dev",
    "dev:backend": "pnpm --filter @pet/backend dev",
    "dev:extension": "pnpm --filter @pet/extension dev",
    "build": "pnpm --filter @pet/shared build && pnpm --parallel --filter \"./apps/*\" build",
    "typecheck": "pnpm --filter @pet/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @pet/shared build && pnpm -r test",
    "lint": "pnpm -r lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.4"
}
