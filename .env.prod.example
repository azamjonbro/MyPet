# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   # then fill in every value marked REQUIRED
#
# Never commit .env.prod. .gitignore already excludes it.

# The domain that points at this VPS. nginx serves it; certbot issues the
# certificate. Used by the API only for logging and Google redirect URIs.
API_DOMAIN=algoritm.techinfo.uz              # REQUIRED

# --- database ---------------------------------------------------------------
# Mongo is created with these credentials on first boot only. Changing them
# later does not change the existing user — you would have to do that in Mongo.
MONGO_USER=pet                                # REQUIRED
MONGO_PASSWORD=                               # REQUIRED — openssl rand -hex 24

# --- secrets ----------------------------------------------------------------
JWT_SECRET=                                   # REQUIRED — openssl rand -hex 32
ENCRYPTION_KEY=                               # REQUIRED — openssl rand -hex 32

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- google sign-in ---------------------------------------------------------
# Leave empty and the extension cannot sign in at all in production: dev auth
# is disabled whenever NODE_ENV=production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- openai -----------------------------------------------------------------
# With no key the backend serves the offline rule-based tutor, which is a
# reasonable way to launch and watch the traffic before paying for tokens.
OPENAI_API_KEY=
OPENAI_MODEL_TUTOR=gpt-4.1
OPENAI_MODEL_CHEAP=gpt-4.1-mini
DAILY_TOKEN_BUDGET=60000

# --- cors -------------------------------------------------------------------
# chrome-extension:// origins are always allowed. This is only for web origins,
# e.g. a marketing site that calls the API. Comma-separated.
CORS_ORIGINS=
