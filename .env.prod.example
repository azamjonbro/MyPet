# Production environment for the API, read by systemd as an EnvironmentFile.
#
#   sudo cp .env.prod.example /etc/ai-english-pet.env
#   sudo chmod 600 /etc/ai-english-pet.env
#   sudo nano /etc/ai-english-pet.env        # fill in the blanks
#
# systemd does NOT strip trailing comments, so never write `KEY=value # note`
# here — the comment would end up inside the value.

NODE_ENV=production

# nginx proxies algoritm.techinfo.uz to this port. 4100 is taken on this box.
PORT=7779

# Shares the VPS's existing mongod. The database is ours alone.
# Fill in the password for the ai_english_pet user.
MONGODB_URI=mongodb://pet:PASSWORD@127.0.0.1:27017/ai_english_pet?authSource=ai_english_pet

# openssl rand -hex 32
JWT_SECRET=

# openssl rand -hex 32
ENCRYPTION_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Dev sign-in is inert under NODE_ENV=production. Google sign-in is the only
# way in, so without these two nobody can log in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# With no key the backend serves the offline rule-based tutor — a reasonable
# way to launch and watch the traffic before paying for tokens.
OPENAI_API_KEY=
OPENAI_MODEL_TUTOR=gpt-4.1
OPENAI_MODEL_CHEAP=gpt-4.1-mini
DAILY_TOKEN_BUDGET=60000

# chrome-extension:// origins are always allowed. This is only for web origins.
CORS_ORIGINS=
