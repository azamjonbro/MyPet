# ---- backend ----
NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/ai-english-pet

# 32+ random chars. Generate: openssl rand -hex 32
JWT_SECRET=
# 64 hex chars (32 bytes) for AES-256-GCM. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Lets you sign in without a Google project while developing. NEVER in production.
DEV_AUTH_ENABLED=true

# ---- google oauth (phase 1, optional until you create a project) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- openai (phase 3) ----
OPENAI_API_KEY=
OPENAI_MODEL_TUTOR=gpt-4.1
OPENAI_MODEL_CHEAP=gpt-4.1-mini
DAILY_TOKEN_BUDGET=60000

# ---- notion (optional; leave blank and the extension hides the feature) ----
# Create an integration at https://www.notion.so/my-integrations, set it to
# "Public" to get a client id and secret, and add the redirect URI below.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4100/api/v1/notion/callback

# ---- email (optional; accountability emails are skipped without it) ----
# Gmail: turn on 2FA, then create an app password at
# https://myaccount.google.com/apppasswords — your normal password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mocha <you@gmail.com>
